# OCPP Simulator Configuration
# Copy to .env.local and modify as needed

# Backend WebSocket URL
# VITE_BACKEND_URL=https://funnier-overfit-lasandra.ngrok-free.dev
VITE_BACKEND_URL=http://localhost:8080
# VITE_BACKEND_URL=https://api.veltrakev.com

# Optional: provide a full WebSocket URL to connect directly (overrides built URL)
# Example: wss://api.veltrakev.com/ws/ocpp/1.6J/1/VELTRAK-DC-01
# VITE_FULL_WS_URL=ws://localhost:8080/ws/ocpp/1.6J/1/VELTRAK-001

# Charger Configuration
# VITE_CHARGER_IDENTITY_1=VT-CHN-AN-001-FC1A
# VITE_CHARGER_IDENTITY_2=VT-CHN-AN-002-FC2A
# VITE_CHARGER_IDENTITY_3=VT-CHN-AN-003-FC3A

# Power Simulation
VITE_MIN_POWER_KW=15
VITE_MAX_POWER_KW=25
VITE_METER_INTERVAL_SECONDS=3

# Environment
VITE_APP_NAME=EV CSMS OCPP Simulator
VITE_APP_VERSION=1.0.0